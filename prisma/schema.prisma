// MUTI — Mymensingh Ultrasound Training Institute
// Data model per section 6 of the build spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  STAFF
  /// A faculty member who signs in to mark attendance for their own classes
  /// (addendum 2, B1). Sees nothing else in the panel.
  TEACHER
}

enum CourseLevel {
  CERTIFICATE
  DIPLOMA
  SPECIAL
}

enum ApplicationType {
  ADMISSION
  FREE_CLASS
  CONTACT
  /// Free sample chapter of the course book (addendum 5, A4).
  BOOK_SAMPLE
}

enum PromoSlot {
  PROMO_A
  PROMO_B
}

enum VideoSource {
  EMBED
  UPLOAD
}

enum VideoPlacement {
  HOME
  ABOUT
  HEALTH
}

enum MediaKind {
  IMAGE
  PDF
  VIDEO
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ADMITTED
  CLOSED
}

enum NoticeCategory {
  ADMISSION
  EXAM
  RESULT
  HOLIDAY
  GENERAL
}

enum BatchStatus {
  UPCOMING
  RUNNING
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum RoutineType {
  LECTURE
  PRACTICAL
  EXAM
  REVIEW
}

enum PartnerType {
  AFFILIATION
  COLLABORATION
  /// Supporters of the free health service (addendum 4, §2.10)
  COMMUNITY
}

/// Serial request for the free health service (addendum 4, §3).
enum HealthStatus {
  REQUESTED
  CONFIRMED
  SEEN
  CANCELLED
}

/// The fixed lists the office can edit without a developer.
enum ContentKind {
  /// "Why choose MUTI" cards on the homepage
  WHY_CHOOSE
  /// Required documents, shown on every course page and /admission
  DOCUMENT
  /// Payment policy lines, shown on every course fee card and /admission
  PAYMENT_POLICY
  /// The numbered "how to enrol" steps on /admission
  ADMISSION_STEP
  /// "What we provide" cards on /health-service (addendum 4)
  HEALTH_SERVICE
  /// Mission / Vision / Values cards on /about
  VALUE
  /// Certificates offered, listed on /accreditation
  CERTIFICATE
}

/// Where an enquiry came from (addendum 2, A3).
/// Employment sector, from the paper admission form's Govt / Private / Others.
enum Employment {
  GOVT
  PRIVATE
  OTHER
}

enum CertificateType {
  COURSE
  SEMESTER
  BOARD
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum BoardResultStatus {
  PASS
  FAIL
  WITHHELD
  ABSENT
}

enum TextPosition {
  LEFT
  CENTER
}

enum LeadSource {
  FACEBOOK
  GOOGLE
  REFERRAL
  WALK_IN
  WEBSITE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  /// Extra permissions granted on top of the role defaults (addendum 3, §8).
  /// See src/lib/permissions.ts. SUPER_ADMIN always has everything.
  permissions  String[] @default([])
  active       Boolean  @default(true)

  /// Two-factor authentication (TOTP). The secret is stored encrypted with a
  /// key derived from AUTH_SECRET, so a database dump alone does not hand over
  /// anyone's authenticator. Null means 2FA is off for this account.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// One-time recovery codes, bcrypt-hashed. A used code is removed.
  backupCodes   String[]  @default([])
  /// Failed sign-in attempts since the last success, for account lockout.
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  /// Address of the last sign-in, so the alert email only fires for a new one.
  /// Stored as a SHA-256 stub: enough to compare, not a stored IP history.
  lastLoginIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs                 ActivityLog[]
  importJobs           ImportJob[]
  approvedCertificates Certificate[]      @relation("CertificateApprover")
  issuedCertificates   Certificate[]      @relation("CertificateIssuer")
  certificatePrints    CertificatePrint[]
  messages             MessageLog[]
  faculty              Faculty?
  attendanceMarked     Attendance[]
}

/// Single row (id = 1) holding the whole Site Settings JSON blob (section 7.11).
model SiteSetting {
  id        Int      @id @default(1)
  json      Json
  updatedAt DateTime @updatedAt
}

model Course {
  id           String        @id @default(cuid())
  slug         String        @unique
  certificates Certificate[]
  boardExams   BoardExam[]
  /// CMU, CMU-BTEB, DMU, ADMU, TVS, DOPPLER, ANOMALY
  code         String        @unique

  nameEn     String
  nameBn     String?
  fullNameEn String
  fullNameBn String?

  level           CourseLevel
  durationMonths  Int
  durationLabelEn String
  durationLabelBn String?

  courseFee    Int
  examFee      Int?
  formFee      Int?
  bookFee      Int?
  offerPrice   Int?
  offerLabelEn String?
  offerLabelBn String?

  lectureClasses   Int?
  practicalClasses Int?

  /// HTML from the Tiptap editor
  overviewEn String? @db.Text
  overviewBn String? @db.Text

  eligibilityEn String? @db.Text
  eligibilityBn String? @db.Text

  certificateNoteEn String?
  certificateNoteBn String?

  /// e.g. "BTEB approved"
  affiliationNote String?

  image         String?
  admissionOpen Boolean @default(true)
  published     Boolean @default(true)
  featured      Boolean @default(false)
  sortOrder     Int     @default(0)

  metaTitle       String?
  metaDescription String?

  routines     CourseRoutine[]
  batches      Batch[]
  applications Application[]
  students     Student[]
  faqs         Faq[]
  results      Result[]
  books        CourseBookOnCourse[]

  /// Soft delete (ERP addendum, 2.4): a course a student holds a certificate
  /// for must never vanish from the record.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model CourseRoutine {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// "1st Semester" etc, null when the course has no semesters
  semester String?
  /// "Lecture 1", "Practical 2"
  label    String
  title    String
  type     RoutineType @default(LECTURE)

  sortOrder Int @default(0)

  sessions ClassSession[]

  @@index([courseId, sortOrder])
}

model Batch {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// "DMU Batch, Session 2026"
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    BatchStatus @default(UPCOMING)
  seats     Int?
  classDays String?
  classTime String?
  note      String?
  published Boolean     @default(true)

  /// Live seat counter (addendum 2, A1). `seatsFilled` rises automatically when
  /// an application is admitted into this batch or a student is created in it;
  /// once an admin edits the number by hand `seatsFilledManual` is set and the
  /// automatic increments stop, so the manual value always wins.
  seatsFilled       Int     @default(0)
  seatsFilledManual Boolean @default(false)
  showSeatCounter   Boolean @default(true)

  sessions     ClassSession[]
  students     Student[]
  boardExams   BoardExam[]
  results      Result[]
  applications Application[]

  /// Soft delete (ERP addendum, 2.4).
  deletedAt DateTime?
  /// Campus (ERP addendum, 2.16).
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate])
}

model Application {
  id     String            @id @default(cuid())
  type   ApplicationType
  status ApplicationStatus @default(NEW)

  name     String
  phone    String
  whatsapp String?
  email    String?
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  /// Passport-size photo the applicant uploaded, or the office added at the desk.
  photo          String?
  qualification  String?
  /// Which medical college the applicant graduated from.
  medicalCollege String?
  bmdc           String?
  location       String?
  preferredDate  DateTime?

  /// The remaining fields of the paper admission form. All optional online:
  /// the office completes anything missing at admission time.
  fatherName       String?
  motherName       String?
  dateOfBirth      DateTime?
  religion         String?
  nationalId       String?
  bloodGroup       String?
  employment       Employment?
  presentAddress   String?     @db.Text
  permanentAddress String?     @db.Text
  /// [{ exam: "SSC" | "HSC" | "MBBS" | "OTHER", year, gpa, board }]
  education        Json?
  message          String?     @db.Text

  adminNote String? @db.Text

  /// Set when this application was admitted and became a student record.
  student Student?

  /// Sample-chapter downloads made with this submission's token (addendum 5).
  sampleDownloads BookSampleDownload[]

  /// Lead attribution (addendum 2, A3).
  source       LeadSource?
  /// Raw campaign data: { utm_source, utm_campaign, fbclid, gclid, referrer, landing }
  utm          Json?
  referralCode String?

  /// Soft delete (ERP addendum, 2.4): an enquiry is a lead record, and the
  /// office should not be able to lose one by pressing the wrong button.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([createdAt])
  @@index([source])
}

model Student {
  id            String  @id @default(cuid())
  /// Passport-size photo, used on the admin record and the ID card.
  photo         String?
  /// Printed on the ID card: the one fact on it that can matter in an emergency.
  bloodGroup    String?
  roll          String  @unique
  certificateNo String? @unique
  name          String
  phone         String?

  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  admissionDate  DateTime?
  completionDate DateTime?
  status         StudentStatus @default(ACTIVE)
  resultGrade    String?
  /// Only verifiable students are exposed through the public /verify page.
  verifiable     Boolean       @default(false)
  note           String?

  /// Addendum 3 — identity, import columns and board identifiers.
  nameBn              String?
  email               String?
  gender              String?
  dateOfBirth         DateTime?
  fatherName          String?
  motherName          String?
  nid                 String?
  bmdc                String?
  /// `bmdc` with spaces, dashes and a leading "A-" stripped, upper-cased —
  /// what /verify matches against.
  bmdcNormalized      String?
  address             String?   @db.Text
  boardRoll           String?   @unique
  boardRegistrationNo String?

  attendance   Attendance[]
  certificates Certificate[]
  boardResults BoardResult[]

  /// Soft delete (ERP addendum, 2.4).
  deletedAt     DateTime?
  /// Campus (ERP addendum, 2.16).
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// The web application this student was admitted from (ERP addendum, 2.8).
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verifiable])
  @@index([bmdc])
  @@index([bmdcNormalized])
  @@index([boardRegistrationNo])
}

/// An issued certificate (addendum 3, §1). BOARD means BTEB issued it and
/// MUTI only records the number; the scanned copy is never shown publicly.
model Certificate {
  id            String            @id @default(cuid())
  certificateNo String            @unique
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchName     String?
  type          CertificateType   @default(COURSE)
  issuedAt      DateTime?
  session       String?
  grade         String?
  verifyToken   String            @unique @default(cuid())
  status        CertificateStatus @default(VALID)
  revokedReason String?

  /// A certificate is a draft until a super admin (or `certificates.issue`)
  /// approves it. Only an approved one may be printed or handed over, so a
  /// staff member can prepare the whole batch without being able to release it.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("CertificateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     User?     @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  /// Handover record: "we gave it to him last year" becomes a date and a name.
  deliveredAt  DateTime?
  deliveredTo  String?
  deliveryNote String?

  prints CertificatePrint[]
  /// Optional scanned copy on the uploads volume.
  file   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([studentId])
  @@index([courseId, status])
}

/// One row per print of a certificate. A certificate printed twice is then
/// visible, which matters the day somebody claims a forgery.
model CertificatePrint {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([certificateId])
}

/// Every public lookup on /verify and /results, so abuse is visible.
model VerificationLog {
  id        String   @id @default(cuid())
  query     String
  type      String
  found     Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A BTEB examination whose results the board published (addendum 3, §2).
model BoardExam {
  id          String    @id @default(cuid())
  title       String
  session     String
  heldIn      String?
  memoNo      String?
  publishedOn DateTime?
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  boardName   String    @default("Bangladesh Technical Education Board")

  /// The examination itself, for the admit card. A board exam record starts
  /// life before the exam (date, centre, who is sitting it) and gains its
  /// results afterwards, so both live on the same row.
  examDate     DateTime?
  /// Free text, e.g. "10:00 am to 1:00 pm", because a board sets it per paper.
  examTime     String?
  centre       String?
  /// The batch sitting this examination; the admit cards are printed for it.
  batchId      String?
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// Printed under the instructions, one per line.
  instructions String?   @db.Text
  /// The board's notice PDF on the uploads volume; downloadable publicly.
  noticeFile   String?
  published    Boolean   @default(false)

  results BoardResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedOn])
}

model BoardResult {
  id             String            @id @default(cuid())
  boardExamId    String
  boardExam      BoardExam         @relation(fields: [boardExamId], references: [id], onDelete: Cascade)
  roll           String
  registrationNo String?
  studentId      String?
  student        Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName    String?
  status         BoardResultStatus @default(PASS)
  gpa            Decimal?          @db.Decimal(4, 2)
  /// Raw board text, e.g. "01101[T], 01103[T,P]".
  failedSubjects String?
  remark         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardExamId, roll])
  @@index([roll])
  @@index([registrationNo])
}

/// One bulk import run (addendum 3, §3).
model ImportJob {
  id           String   @id @default(cuid())
  entity       String
  fileName     String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  total        Int      @default(0)
  created      Int      @default(0)
  updated      Int      @default(0)
  skipped      Int      @default(0)
  /// [{ row, message }]
  errors       Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Chairman's / MD's message and any further role (addendum 3, §4).
model LeadershipMessage {
  id              String  @id @default(cuid())
  key             String  @unique
  roleTitleBn     String?
  roleTitleEn     String
  personName      String
  personNameBn    String?
  degrees         String?
  designationLine String?
  photo           String?
  messageBn       String? @db.Text
  messageEn       String  @db.Text
  excerptBn       String?
  excerptEn       String?
  signatureImage  String?
  sortOrder       Int     @default(0)
  published       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Advisory board member (addendum 3, §5). `category` is a free label the
/// office manages in Site Settings.
model Advisor {
  id            String  @id @default(cuid())
  name          String
  nameBn        String?
  degrees       String?
  designation   String
  designationBn String?
  organization  String?
  bio           String? @db.Text
  photo         String?
  category      String  @default("ADVISOR")
  sortOrder     Int     @default(0)
  published     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, category, sortOrder])
}

model Result {
  id       String  @id @default(cuid())
  title    String
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  examDate  DateTime?
  fileUrl   String?
  bodyHtml  String?   @db.Text
  published Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, examDate])
}

model Notice {
  id      String  @id @default(cuid())
  slug    String  @unique
  titleBn String?
  titleEn String
  bodyBn  String? @db.Text
  bodyEn  String  @db.Text

  category    NoticeCategory @default(GENERAL)
  pinned      Boolean        @default(false)
  publishedAt DateTime       @default(now())
  expiresAt   DateTime?
  published   Boolean        @default(true)
  /// [{ name, url }]
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, pinned, publishedAt])
}

model Faculty {
  id            String  @id @default(cuid())
  name          String
  nameBn        String?
  degrees       String
  designation   String
  designationBn String?
  bio           String? @db.Text
  photo         String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)

  /// Set when this teacher has a login of their own (addendum 2, B1).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  batch     String?
  course    String?
  text      String  @db.Text
  photo     String?
  rating    Int     @default(5)
  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryAlbum {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  titleBn         String?
  cover           String?
  sortOrder       Int     @default(0)
  /// Shown on /health-service (addendum 4, §2.9). Consented photos only.
  isHealthService Boolean @default(false)

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int          @default(0)

  @@index([albumId, sortOrder])
}

model Faq {
  id         String  @id @default(cuid())
  questionBn String?
  questionEn String
  answerBn   String? @db.Text
  answerEn   String  @db.Text
  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder  Int     @default(0)
  published  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleBn     String?
  titleEn     String
  excerpt     String?
  bodyBn      String?   @db.Text
  bodyEn      String    @db.Text
  cover       String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  /// Draft written from the course book; a doctor must approve it before it
  /// is published (addendum 5, A5).
  needsReview Boolean   @default(false)

  /// Who checked the medical content, and when (addendum 5, A5). The reviewer
  /// is a doctor, not necessarily an admin account, so the name is typed.
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

/// about-story, privacy, terms — simple rich-text pages
model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  titleBn   String?
  titleEn   String
  bodyBn    String? @db.Text
  bodyEn    String  @db.Text
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Download {
  id        String  @id @default(cuid())
  title     String
  fileUrl   String
  category  String?
  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id          String      @id @default(cuid())
  name        String
  type        PartnerType
  logo        String?
  description String?
  url         String?
  sortOrder   Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Hero slide (addendum 3, §6). `title`/`subtitle` are the English copy;
/// the Bangla pair sits beside them. Empty image = a brand gradient slide.
model Banner {
  id           String       @id @default(cuid())
  title        String?
  subtitle     String?
  titleBn      String?
  subtitleBn   String?
  image        String
  mobileImage  String?
  link         String?
  ctaLabelBn   String?
  ctaLabelEn   String?
  ctaLink      String?
  cta2LabelBn  String?
  cta2LabelEn  String?
  cta2Link     String?
  /// Dark overlay strength, 0–80 percent.
  overlay      Int          @default(40)
  textPosition TextPosition @default(LEFT)
  startAt      DateTime?
  endAt        DateTime?
  sortOrder    Int          @default(0)
  active       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per bullet, card or step in the site's fixed lists. A single model
 * keeps six small editors working through the same admin screens instead of
 * six near-identical tables.
 */
model ContentItem {
  id   String      @id @default(cuid())
  kind ContentKind

  /// Lucide icon name, used by the "why choose" cards only.
  icon    String?
  titleBn String?
  titleEn String?
  bodyBn  String? @db.Text
  bodyEn  String  @db.Text

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, published, sortOrder])
}

model ActivityLog {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action   String
  entity   String
  entityId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Postgres-backed rate limiter for public forms and /verify (section 11).
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  scope     String
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
}

/**
 * ---- Addendum 4: free health service ------------------------------------
 */

/// Patient serial for the free ultrasound service. Health data: the form
/// collects the minimum, nothing here is ever public, and name/phone are
/// replaced by a hash 90 days after the visit (`anonymizedAt`).
model HealthAppointment {
  id              String       @id @default(cuid())
  /// Calendar day the serial belongs to, "YYYYMMDD"; numbers restart daily.
  serialDate      String
  serialNo        Int
  name            String
  phone           String
  age             Int?
  gender          String?
  area            String?
  complaint       String?
  preferredDate   DateTime?
  referredBy      String?
  /// Addendum 4.1: YES / NO / NA, and months of pregnancy when YES.
  pregnant        String?
  pregnancyMonths Int?
  status          HealthStatus @default(REQUESTED)
  note            String?
  anonymizedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serialDate, serialNo])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Atomic counters, e.g. "health-serial-20260912" (addendum 4, §3).
model Counter {
  key   String @id
  value Int    @default(0)
}

/// One row per service day: how many patients were seen and reports given.
/// Feeds the public impact stats on top of the base figures in Site Settings.
model HealthDailyCount {
  date          String @id
  patients      Int    @default(0)
  reports       Int    @default(0)
  consultations Int    @default(0)

  updatedAt DateTime @updatedAt
}

/// Uploaded files that carry metadata the admin needs (videos, posters, the
/// protected sample PDF). Ordinary images and PDFs are listed straight from
/// storage, so this table only holds what the media grid cannot infer.
model Media {
  id        String    @id @default(cuid())
  /// Storage key, e.g. "2026-09/abc.mp4" or "protected/2026-09/abc.pdf".
  key       String    @unique
  url       String
  kind      MediaKind
  /// "video", "poster", "protected", "promo" …
  tag       String?
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  /// Seconds, for videos.
  duration  Int?
  /// Never served by the public /uploads route; only by a signed route.
  protected Boolean   @default(false)

  videos  SiteVideo[]  @relation("VideoFile")
  posters SiteVideo[]  @relation("VideoPoster")
  books   CourseBook[]

  createdAt DateTime @default(now())
}

/// Homepage promo slots: posters the office designs and uploads.
model Promo {
  id           String    @id @default(cuid())
  slot         PromoSlot
  title        String
  image        String
  mobileImage  String?
  link         String?
  openInNewTab Boolean   @default(false)
  isOffer      Boolean   @default(false)
  showAsPopup  Boolean   @default(false)
  startAt      DateTime?
  endAt        DateTime?
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  clicks       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, active, sortOrder])
}

/// Institute videos: a YouTube/Facebook embed or a self-hosted MP4.
model SiteVideo {
  id            String         @id @default(cuid())
  title         String
  description   String?        @db.Text
  source        VideoSource    @default(EMBED)
  embedUrl      String?
  fileId        String?
  file          Media?         @relation("VideoFile", fields: [fileId], references: [id], onDelete: SetNull)
  posterId      String?
  poster        Media?         @relation("VideoPoster", fields: [posterId], references: [id], onDelete: SetNull)
  /// Poster override by path, for embeds and hand-made thumbnails.
  posterImage   String?
  autoplayMuted Boolean        @default(false)
  showOnHome    Boolean        @default(false)
  placement     VideoPlacement @default(HOME)
  sortOrder     Int            @default(0)
  published     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, published, sortOrder])
}

/// MUTI's own course book (addendum 5, part A).
model CourseBook {
  id                 String  @id @default(cuid())
  slug               String  @unique
  title              String
  subtitle           String?
  edition            String?
  coverImage         String?
  description        String? @db.Text
  descriptionBn      String? @db.Text
  pages              Int?
  priceNote          String?
  samplePdfFileId    String?
  samplePdf          Media?  @relation(fields: [samplePdfFileId], references: [id], onDelete: SetNull)
  sampleChapterTitle String?
  published          Boolean @default(false)

  chapters CourseBookChapter[]
  courses  CourseBookOnCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseBookChapter {
  id        String     @id @default(cuid())
  bookId    String
  book      CourseBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  titleBn   String?
  summary   String?
  topics    String[]
  isSample  Boolean    @default(false)
  sortOrder Int        @default(0)

  @@unique([bookId, number])
}

model CourseBookOnCourse {
  bookId   String
  book     CourseBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  courseId String
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([bookId, courseId])
}

/// One row per download of the sample chapter through a signed token.
model BookSampleDownload {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ip            String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([createdAt])
}

/// Which way a message went out (addendum 2, A4 — SMS and WhatsApp).
enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum MessageStatus {
  /// Accepted by the provider.
  SENT
  /// The provider refused it, or no provider is configured.
  FAILED
  /// Deliberately not sent: no phone number, or the office turned it off.
  SKIPPED
}

/// The wording of one automatic or one-click message. Seeded with a set of
/// keys the code knows about; the office edits the text, never the key.
model MessageTemplate {
  id      String         @id @default(cuid())
  /// Stable identifier the sender looks up, e.g. "application-received".
  key     String         @unique
  name    String
  channel MessageChannel @default(SMS)
  /// Placeholders in braces: {name} {course} {batch} {date} {time} {serial}
  /// {roll} {institute} {phone}. Unknown ones are left as typed.
  body    String         @db.Text
  active  Boolean        @default(true)
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Every message the system sent or tried to send. This is the outbox the
/// office reads when a student says "I was never told", and the record that
/// stops an automatic reminder going out twice.
model MessageLog {
  id        String         @id @default(cuid())
  channel   MessageChannel
  /// Phone in +8801XXXXXXXXX form, or an email address.
  to        String
  body      String         @db.Text
  status    MessageStatus
  /// Which provider accepted or refused it, for reading the log later.
  provider  String?
  error     String?
  template  String?
  /// What the message was about: "application", "student", "appointment", …
  entity    String?
  entityId  String?
  /// Set for automatic messages only, and unique, so a reminder sent once is
  /// never sent again however often the job runs.
  dedupeKey String?        @unique
  /// The admin who pressed send; empty for anything the scheduler sent.
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([channel, status])
}

/// One page view, counted without a cookie and without storing an address
/// (addendum 2, A6). `visitor` is a hash that changes every day, so the same
/// person can be counted once today and is unrecognisable tomorrow.
model PageView {
  id           String   @id @default(cuid())
  /// "YYYYMMDD" in Dhaka time, which is the day the office thinks in.
  day          String
  path         String
  locale       String?
  /// Host only, never the full referring URL.
  referrerHost String?
  /// "mobile" or "desktop".
  device       String?
  visitor      String
  createdAt    DateTime @default(now())

  @@index([day])
  @@index([day, path])
  @@index([day, visitor])
}

/// A campus (ERP addendum, 2.16). One row today, "Mymensingh". Carrying the
/// column now means a second campus is a filter later rather than a migration
/// across every table that matters.
model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  address   String?
  phone     String?
  active    Boolean   @default(true)
  students  Student[]
  batches   Batch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ClassSessionStatus {
  PLANNED
  DONE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One class of one batch (addendum 2, B1). Generated from the course routine
/// and editable afterwards, because a real timetable moves.
model ClassSession {
  id              String             @id @default(cuid())
  batchId         String
  batch           Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseRoutineId String?
  courseRoutine   CourseRoutine?     @relation(fields: [courseRoutineId], references: [id], onDelete: SetNull)
  date            DateTime
  /// Free text, because a routine says "10:00 am" rather than a timestamp.
  startTime       String?
  topic           String
  type            RoutineType        @default(LECTURE)
  teacherId       String?
  teacher         Faculty?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  status          ClassSessionStatus @default(PLANNED)
  note            String?

  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, date])
  @@index([teacherId, date])
}

/// One student at one class. Absent rows are written too: "nobody marked it"
/// and "marked absent" are different answers and the office needs both.
model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(PRESENT)
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}
