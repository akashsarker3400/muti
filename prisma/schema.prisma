// MUTI — Mymensingh Ultrasound Training Institute
// Data model per section 6 of the build spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum CourseLevel {
  CERTIFICATE
  DIPLOMA
  SPECIAL
}

enum ApplicationType {
  ADMISSION
  FREE_CLASS
  CONTACT
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ADMITTED
  CLOSED
}

enum NoticeCategory {
  ADMISSION
  EXAM
  RESULT
  HOLIDAY
  GENERAL
}

enum BatchStatus {
  UPCOMING
  RUNNING
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum RoutineType {
  LECTURE
  PRACTICAL
  EXAM
  REVIEW
}

enum PartnerType {
  AFFILIATION
  COLLABORATION
}

/// The fixed lists the office can edit without a developer.
enum ContentKind {
  /// "Why choose MUTI" cards on the homepage
  WHY_CHOOSE
  /// Required documents, shown on every course page and /admission
  DOCUMENT
  /// Payment policy lines, shown on every course fee card and /admission
  PAYMENT_POLICY
  /// The numbered "how to enrol" steps on /admission
  ADMISSION_STEP
  /// Mission / Vision / Values cards on /about
  VALUE
  /// Certificates offered, listed on /accreditation
  CERTIFICATE
}

/// Where an enquiry came from (addendum 2, A3).
/// Employment sector, from the paper admission form's Govt / Private / Others.
enum Employment {
  GOVT
  PRIVATE
  OTHER
}

enum LeadSource {
  FACEBOOK
  GOOGLE
  REFERRAL
  WALK_IN
  WEBSITE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs ActivityLog[]
}

/// Single row (id = 1) holding the whole Site Settings JSON blob (section 7.11).
model SiteSetting {
  id        Int      @id @default(1)
  json      Json
  updatedAt DateTime @updatedAt
}

model Course {
  id   String @id @default(cuid())
  slug String @unique
  /// CMU, CMU-BTEB, DMU, ADMU, TVS, DOPPLER, ANOMALY
  code String @unique

  nameEn     String
  nameBn     String
  fullNameEn String
  fullNameBn String

  level           CourseLevel
  durationMonths  Int
  durationLabelEn String
  durationLabelBn String

  courseFee    Int
  examFee      Int?
  formFee      Int?
  bookFee      Int?
  offerPrice   Int?
  offerLabelEn String?
  offerLabelBn String?

  lectureClasses   Int?
  practicalClasses Int?

  /// HTML from the Tiptap editor
  overviewEn String? @db.Text
  overviewBn String? @db.Text

  eligibilityEn String? @db.Text
  eligibilityBn String? @db.Text

  certificateNoteEn String?
  certificateNoteBn String?

  /// e.g. "BTEB approved"
  affiliationNote String?

  image         String?
  admissionOpen Boolean @default(true)
  published     Boolean @default(true)
  featured      Boolean @default(false)
  sortOrder     Int     @default(0)

  metaTitle       String?
  metaDescription String?

  routines     CourseRoutine[]
  batches      Batch[]
  applications Application[]
  students     Student[]
  faqs         Faq[]
  results      Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model CourseRoutine {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// "1st Semester" etc, null when the course has no semesters
  semester String?
  /// "Lecture 1", "Practical 2"
  label    String
  title    String
  type     RoutineType @default(LECTURE)

  sortOrder Int @default(0)

  @@index([courseId, sortOrder])
}

model Batch {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// "DMU Batch, Session 2026"
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    BatchStatus @default(UPCOMING)
  seats     Int?
  classDays String?
  classTime String?
  note      String?
  published Boolean     @default(true)

  /// Live seat counter (addendum 2, A1). `seatsFilled` rises automatically when
  /// an application is admitted into this batch or a student is created in it;
  /// once an admin edits the number by hand `seatsFilledManual` is set and the
  /// automatic increments stop, so the manual value always wins.
  seatsFilled       Int     @default(0)
  seatsFilledManual Boolean @default(false)
  showSeatCounter   Boolean @default(true)

  students     Student[]
  results      Result[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate])
}

model Application {
  id     String            @id @default(cuid())
  type   ApplicationType
  status ApplicationStatus @default(NEW)

  name     String
  phone    String
  whatsapp String?
  email    String?
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  qualification String?
  /// Which medical college the applicant graduated from.
  medicalCollege String?
  bmdc          String?
  location      String?
  preferredDate DateTime?

  /// The remaining fields of the paper admission form. All optional online:
  /// the office completes anything missing at admission time.
  fatherName       String?
  motherName       String?
  dateOfBirth      DateTime?
  religion         String?
  nationalId       String?
  bloodGroup       String?
  employment       Employment?
  presentAddress   String? @db.Text
  permanentAddress String? @db.Text
  /// [{ exam: "SSC" | "HSC" | "MBBS" | "OTHER", year, gpa, board }]
  education        Json?
  message       String?   @db.Text

  adminNote String? @db.Text

  /// Lead attribution (addendum 2, A3).
  source        LeadSource?
  /// Raw campaign data: { utm_source, utm_campaign, fbclid, gclid, referrer, landing }
  utm           Json?
  referralCode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([createdAt])
  @@index([source])
}

model Student {
  id            String  @id @default(cuid())
  roll          String  @unique
  certificateNo String? @unique
  name          String
  phone         String?

  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  admissionDate  DateTime?
  completionDate DateTime?
  status         StudentStatus @default(ACTIVE)
  resultGrade    String?
  /// Only verifiable students are exposed through the public /verify page.
  verifiable     Boolean       @default(false)
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verifiable])
}

model Result {
  id       String  @id @default(cuid())
  title    String
  batchId  String?
  batch    Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  examDate  DateTime?
  fileUrl   String?
  bodyHtml  String?   @db.Text
  published Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, examDate])
}

model Notice {
  id      String  @id @default(cuid())
  slug    String  @unique
  titleBn String
  titleEn String?
  bodyBn  String  @db.Text
  bodyEn  String? @db.Text

  category    NoticeCategory @default(GENERAL)
  pinned      Boolean        @default(false)
  publishedAt DateTime       @default(now())
  expiresAt   DateTime?
  published   Boolean        @default(true)
  /// [{ name, url }]
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, pinned, publishedAt])
}

model Faculty {
  id            String  @id @default(cuid())
  name          String
  nameBn        String?
  degrees       String
  designation   String
  designationBn String?
  bio           String? @db.Text
  photo         String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  batch     String?
  course    String?
  text      String  @db.Text
  photo     String?
  rating    Int     @default(5)
  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryAlbum {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  titleBn   String?
  cover     String?
  sortOrder Int     @default(0)

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int          @default(0)

  @@index([albumId, sortOrder])
}

model Faq {
  id         String  @id @default(cuid())
  questionBn String
  questionEn String?
  answerBn   String  @db.Text
  answerEn   String? @db.Text
  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder  Int     @default(0)
  published  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleBn     String
  titleEn     String?
  excerpt     String?
  bodyBn      String    @db.Text
  bodyEn      String?   @db.Text
  cover       String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

/// about-story, privacy, terms — simple rich-text pages
model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  titleBn   String
  titleEn   String?
  bodyBn    String  @db.Text
  bodyEn    String? @db.Text
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Download {
  id        String  @id @default(cuid())
  title     String
  fileUrl   String
  category  String?
  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id          String      @id @default(cuid())
  name        String
  type        PartnerType
  logo        String?
  description String?
  url         String?
  sortOrder   Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String  @id @default(cuid())
  title     String?
  subtitle  String?
  image     String
  link      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per bullet, card or step in the site's fixed lists. A single model
 * keeps six small editors working through the same admin screens instead of
 * six near-identical tables.
 */
model ContentItem {
  id   String      @id @default(cuid())
  kind ContentKind

  /// Lucide icon name, used by the "why choose" cards only.
  icon    String?
  titleBn String?
  titleEn String?
  bodyBn  String  @db.Text
  bodyEn  String? @db.Text

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, published, sortOrder])
}

model ActivityLog {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action   String
  entity   String
  entityId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Postgres-backed rate limiter for public forms and /verify (section 11).
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  scope     String
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
}
